    "metadata.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "View live system power consumption, battery status, and charging details." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "实时查看系统功耗、电池状态和充电信息" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "即時查看系統功耗、電池狀態和充電資訊" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "システムの電力消費、バッテリー状態、充電情報をリアルタイムで表示します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시스템 전력 소비, 배터리 상태 및 충전 정보를 실시간으로 확인하세요." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Live-Anzeige von Energieverbrauch, Batteriestatus und Ladeinformationen." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Affichez la consommation d'énergie, l'état de la batterie et les détails de charge en direct." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Consulta el consumo de energía del sistema, el estado de la batería y los detalles de carga en vivo." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Veja o consumo de energia do sistema, o estado da bateria e os detalhes de carregamento ao vivo." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Просмотр энергопотребления системы, состояния батареи и информации о зарядке в реальном времени." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sistem güç tüketimini, pil durumunu ve şarj bilgilerini canlı olarak görüntüleyin." } },
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "عرض استهلاك الطاقة وحالة البطارية ومعلومات الشحن في الوقت الفعلي." } }
      }
    },
