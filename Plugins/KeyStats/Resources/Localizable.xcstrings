    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track usage for every key and your trackpad, keeping the last seven days."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع استخدام كل مفتاح ولوحة التتبع مع الاحتفاظ ببيانات سبعة أيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgen Sie die Nutzung jeder Taste und des Trackpads über sieben Tage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra el uso de cada tecla y del panel táctil durante los últimos siete días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez l’utilisation de chaque touche et du pavé tactile sur les sept derniers jours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各キーとトラックパッドの使用回数を記録し、直近 7 日分を保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 키와 트랙패드 사용 횟수를 기록하고 최근 7일간 보관합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe o uso de cada tecla e do trackpad nos últimos sete dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживайте использование каждой клавиши и трекпада за последние семь дней."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her tuşun ve izleme dörtgeninin kullanımını son yedi gün boyunca izleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统计每个按键与触控板的使用次数，保留近七天数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "統計每個按鍵與觸控板的使用次數，保留近七天資料"
          }
        }
      }
    },
