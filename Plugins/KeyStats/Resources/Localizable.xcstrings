    "permission.inputMonitoring.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow MacTools in System Settings → Privacy & Security → Input Monitoring. If counting still does not start, restart MacTools."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ MacTools في إعدادات النظام ← الخصوصية والأمان ← مراقبة الإدخال. إذا لم يبدأ التتبع، فأعد تشغيل MacTools."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie MacTools unter Systemeinstellungen → Datenschutz & Sicherheit → Eingabeüberwachung. Falls die Erfassung nicht startet, starten Sie MacTools neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite MacTools en Ajustes del Sistema → Privacidad y seguridad → Monitorización de entrada. Si el registro no comienza, reinicia MacTools."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez MacTools dans Réglages Système → Confidentialité et sécurité → Surveillance de l’entrée. Si le suivi ne démarre pas, redémarrez MacTools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → 入力監視で MacTools を許可してください。記録が始まらない場合は MacTools を再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인정보 보호 및 보안 → 입력 모니터링에서 MacTools를 허용하세요. 그래도 기록되지 않으면 MacTools를 다시 실행하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o MacTools em Ajustes do Sistema → Privacidade e Segurança → Monitorização de entrada. Se o registo não começar, reinicie o MacTools."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите MacTools в Системных настройках → Конфиденциальность и безопасность → Мониторинг ввода. Если учёт не начался, перезапустите MacTools."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları → Gizlilik ve Güvenlik → Girdi İzleme bölümünde MacTools’a izin verin. Kayıt başlamazsa MacTools’u yeniden başlatın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许 MacTools 进行输入监控；若授权后仍无法统计，请重新启动 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中允許 MacTools 進行輸入監控；若授權後仍無法統計，請重新啟動 MacTools。"
          }
        }
      }
    },
